class Solution {
    public boolean rotateString(String s, String goal) {
        // If lengths don't match, they can't be rotations of each other
        if (s.length() != goal.length()) {
            return false;
        }
        
        // A rotated version of s will always be a substring of s + s
        String doubled = s + s;
        return doubled.contains(goal);
    }
}
