import java.util.Scanner;

public class DigitSum {
    // Method to calculate sum of even digits
    public static int sumEvenDigits(int number) {
        int sum = 0;
        while (number > 0) {
            int digit = number % 10;
            if (digit % 2 == 0) {
                sum += digit;
            }
            number /= 10;
        }
        return sum;
    }

    // Method to calculate sum of odd digits
    public static int sumOddDigits(int number) {
        int sum = 0;
        while (number > 0) {
            int digit = number % 10;
            if (digit % 2 != 0) {
                sum += digit;
            }
            number /= 10;
        }
        return sum;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        System.out.print("Enter a number: ");
        int num = sc.nextInt();
        
        System.out.println("Sum of even digits: " + sumEvenDigits(num));
        System.out.println("Sum of odd digits: " + sumOddDigits(num));
        
        sc.close();
    }
}
