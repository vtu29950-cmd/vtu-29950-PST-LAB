import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        if (!scanner.hasNextInt()) {
            return;
        }
        
        int n = scanner.nextInt();
        
        // Create an ArrayList of ArrayLists to store the rows
        ArrayList<ArrayList<Integer>> lines = new ArrayList<>();
        
        for (int i = 0; i < n; i++) {
            int d = scanner.nextInt();
            ArrayList<Integer> row = new ArrayList<>();
            for (int j = 0; j < d; j++) {
                row.add(scanner.nextInt());
            }
            lines.add(row);
        }
        
        if (!scanner.hasNextInt()) {
            return;
        }
        
        int q = scanner.nextInt();
        
        for (int i = 0; i < q; i++) {
            int x = scanner.nextInt(); // line number (1-based index)
            int y = scanner.nextInt(); // position number (1-based index)
            
            // Convert 1-based indices to 0-based indices for ArrayList
            int lineIndex = x - 1;
            int posIndex = y - 1;
            
            // Check if the line index and position index are valid
            if (lineIndex >= 0 && lineIndex < lines.size() && 
                posIndex >= 0 && posIndex < lines.get(lineIndex).size()) {
                System.out.println(lines.get(lineIndex).get(posIndex));
            } else {
                System.out.println("ERROR!");
            }
        }
        
        scanner.close();
    }
}
