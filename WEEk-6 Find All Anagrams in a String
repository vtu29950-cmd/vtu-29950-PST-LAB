import java.util.ArrayList;
import java.util.List;

class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> result = new ArrayList<>();
        if (s == null || p == null || s.length() < p.length()) {
            return result;
        }
        
        int[] pCount = new int[26];
        int[] sCount = new int[26];
        
        // Count frequencies for pattern p and the first window in s
        for (int i = 0; i < p.length(); i++) {
            pCount[p.charAt(i) - 'a']++;
            sCount[s.charAt(i) - 'a']++;
        }
        
        int pLen = p.length();
        
        // Check the first window
        if (matches(pCount, sCount)) {
            result.add(0);
        }
        
        // Slide the window over string s
        for (int i = pLen; i < s.length(); i++) {
            // Add the new character entering the window on the right
            sCount[s.charAt(i) - 'a']++;
            // Remove the character leaving the window on the left
            sCount[s.charAt(i - pLen) - 'a']--;
            
            // Check if frequency arrays match
            if (matches(pCount, sCount)) {
                result.add(i - pLen + 1);
            }
        }
        
        return result;
    }
    
    private boolean matches(int[] arr1, int[] arr2) {
        for (int i = 0; i < 26; i++) {
            if (arr1[i] != arr2[i]) {
                return false;
            }
        }
        return true;
    }
}
