import java.util.Calendar;
import java.util.Locale;

class Result {

    /*
     * Complete the 'findDay' function below.
     *
     * The function is expected to return a STRING.
     * The function accepts following parameters:
     *  1. INTEGER month
     *  2. INTEGER day
     *  3. INTEGER year
     */

    public static String findDay(int month, int day, int year) {
        Calendar calendar = Calendar.getInstance();
        // Month in Calendar class is 0-indexed (0 for January, 11 for December)
        calendar.set(year, month - 1, day);
        
        // Get the day of the week as a string in capital letters (e.g., "WEDNESDAY")
        String dayOfWeek = calendar.getDisplayName(Calendar.DAY_OF_WEEK, Calendar.LONG, Locale.ENGLISH);
        
        return dayOfWeek.toUpperCase();
    }

}
